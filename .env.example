# ============================================
# Application
# ============================================

APP_NAME=Event-Driven Supply Chain Risk Intelligence
APP_ENV=development
DEBUG=true


# ============================================
# Neo4j Knowledge Graph
# ============================================

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j


# ============================================
# News / Event Ingestion
# ============================================

NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

# Preferred live FYP mode: run the news poller as a FastAPI lifespan task so
# it shares the same in-memory WebSocket ConnectionManager as /risk-stream.
NEWS_POLLER_ENABLED=false
NEWS_POLL_INTERVAL_SECONDS=900
NEWS_REQUEST_TIMEOUT_SECONDS=20.0
NEWS_MAX_RETRIES=4
NEWS_DATABASE_PATH=data/news/news.db

EVENT_CLASSIFIER_MODEL_PATH=models/event_classifier/distilbert_supply_chain
EVENT_CLASSIFIER_MAX_LENGTH=256
EVENT_CLASSIFIER_CONFIDENCE_THRESHOLD=0.70


# ============================================
# Corporate Disclosure Ingestion
# ============================================

# SEC EDGAR requires a descriptive User-Agent including contact information.
SEC_USER_AGENT=

# Korea Financial Supervisory Service OpenDART API key.
OPENDART_API_KEY=

# Optional shared concurrency for the multi-source disclosure runner.
DISCLOSURE_MAX_CONCURRENCY=8


# ============================================
# LLM / Agentic RAG
# ============================================

# Supported production provider: openai
LLM_PROVIDER=openai
LLM_API_KEY=
# Use a model available to your OpenAI API project.
LLM_MODEL=


# ============================================
# API
# ============================================

API_HOST=127.0.0.1
API_PORT=8000
